# Aplikasi
APP_NAME="IndoFX"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Basis URL berkas aset. Kosongkan untuk memakai /public lokal.
# Saat pindah ke Supabase Storage, isi dengan URL bucket, contoh:
# STORAGE_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/indofx
STORAGE_BASE_URL=
APP_TIMEZONE=Asia/Jakarta

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=indofx
DB_USER=jonathan
DB_PASSWORD=menyesuaikan
DB_SSLMODE=prefer

# Sesi
SESSION_NAME=indofx_session
SESSION_LIFETIME=120

# Midtrans (mode Sandbox untuk pengembangan)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Email transaksional
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@indofx.id
MAIL_FROM_NAME="IndoFX"

# Penyimpanan berkas aset (Google Drive Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_ROOT_FOLDER_ID=
