# Aplikasi
APP_NAME="IndoFX"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# Database PostgreSQL (Terhubung ke Supabase Session Pooler)
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.fjjcuvbhwjtyvmlddevj
DB_PASSWORD=ISI_PASSWORD_DATABASE_SUPABASE
DB_SSLMODE=require

# Sesi
SESSION_NAME=indofx_session
SESSION_LIFETIME=120

# Midtrans (mode Sandbox untuk pengembangan)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Email transaksional
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@indofx.id
MAIL_FROM_NAME="IndoFX"

# Penyimpanan berkas aset (Supabase Storage)
SUPABASE_URL=https://fjjcuvbhwjtyvmlddevj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ISI_SERVICE_ROLE_KEY_DARI_MENU_API_KEYS
SUPABASE_BUCKET_FILES=game-assets
SUPABASE_BUCKET_IMAGES=asset-previews
