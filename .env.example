# Aplikasi
APP_NAME="IndoFX"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Jakarta

# Basis URL berkas aset. Kosongkan untuk memakai file lokal di public/.
# Saat pindah ke Supabase Storage, isi dengan URL bucket publik.
# Panduan lengkap: docs/panduan-supabase.md
STORAGE_BASE_URL=

# Database PostgreSQL (lokal)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=indofx
DB_USER=indofx
DB_PASSWORD=
DB_SSLMODE=prefer

# Contoh isi untuk Supabase (database):
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<password-database>
# DB_SSLMODE=require

# Sesi
SESSION_NAME=indofx_session
SESSION_LIFETIME=120

# Midtrans (mode Sandbox untuk pengembangan)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Email transaksional
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@indofx.id
MAIL_FROM_NAME="IndoFX"

# Penyimpanan berkas aset (Google Drive Service Account)
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_ROOT_FOLDER_ID=
