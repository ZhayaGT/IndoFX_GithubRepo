{
  "name": "indofx/indofx",
  "description": "Platform marketplace & komunitas aset digital Unity CG dan VFX Indonesia",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "erusev/parsedown": "^1.7",
    "google/apiclient": "^2.16",
    "monolog/monolog": "^3.6",
    "phpmailer/phpmailer": "^6.9",
    "vlucas/phpdotenv": "^5.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "friendsofphp/php-cs-fixer": "^3.50"
  },
  "autoload": {
    "psr-4": {
      "IndoFX\\": "app/"
    },
    "files": [
      "app/Helpers/format.php",
      "app/Helpers/markdown.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "IndoFX\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public",
    "lint": "php-cs-fixer fix --dry-run --diff --rules=@PSR12",
    "lint:fix": "php-cs-fixer fix --rules=@PSR12",
    "test": "phpunit",
    "migrate": "php database/migrate.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
